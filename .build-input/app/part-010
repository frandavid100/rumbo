    onSave: (Map<MealType, Double>) -> Unit
) {
    var values by remember(mealShares) {
        mutableStateOf(MealType.entries.associateWith { type ->
            ((mealShares[type] ?: defaultMealShares.getValue(type)) * 100.0)
                .roundToInt().toString()
